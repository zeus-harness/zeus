{
  "name": "@zeus/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "pnpm generate:api && vite build",
    "preview": "vite preview",
    "check": "pnpm generate:api && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "generate:api": "openapi-typescript ../../openapi/zeus.v1.yaml -o src/lib/api/generated/schema.d.ts"
  },
  "dependencies": {
    "@lucide/svelte": "^1.35.0",
    "@zeus/ui": "workspace:*"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "5.5.7",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.4.0",
    "openapi-typescript": "7.13.0",
    "svelte": "5.56.10",
    "svelte-check": "4.7.6",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
