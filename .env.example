DATABASE_URL=DATABASE_URL_HERE
RUNTIME_DATABASE_URL=DATABASE_URL_HERE
# The DATABASE_URL login must be allowed to SET ROLE zeus_http.
# The RUNTIME_DATABASE_URL login must be allowed to SET ROLE zeus_runtime.
ZEUS_BIND_ADDRESS=0.0.0.0:8080
ZEUS_PUBLIC_URL=https://zeus.example.com
ZEUS_RUN_CONCURRENCY=4
ZEUS_SUPERVISOR_ENABLED=false
# Local development only. Production mounts a 0400 file and sets ZEUS_ENVELOPE_KEY_FILE.
ZEUS_LOCAL_MASTER_KEY=LOCAL_MASTER_KEY_HERE
ZEUS_ENVELOPE_KEY_ID=local-v1
# ZEUS_ENVELOPE_KEY_FILE=/var/run/secrets/zeus/envelope-key
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector.observability.svc.cluster.local:4318
OIDC_ISSUER_URL=https://identity.example.com
OIDC_CLIENT_ID=OIDC_CLIENT_ID_HERE
OIDC_CLIENT_SECRET=OIDC_CLIENT_SECRET_HERE
