# Copy to .env for Docker Compose development. Values here are local-only.
COMPOSE_PROJECT_NAME=zeus

# Pinned container/toolchain versions
# PostgreSQL is an optional future adapter/test target (`--profile postgres`),
# not the current authoritative store.
POSTGRES_VERSION=18.6
RESTATE_VERSION=1.7.6
MINIO_VERSION=RELEASE.2025-09-07T16-13-09Z
CADDY_VERSION=2.10.2
RUST_VERSION=1.97.1
NODE_VERSION=24.18.0
PNPM_VERSION=10.33.0

# Host bindings (all management/data ports remain loopback-only)
ZEUS_HTTP_PORT=8088
ZEUS_API_PORT=8081
ZEUS_WEB_PORT=3000
ZEUS_RUST_DEBUG_PORT=2345
ZEUS_NODE_DEBUG_PORT=9229
POSTGRES_PORT=5432
RESTATE_INGRESS_PORT=8080
RESTATE_ADMIN_PORT=9070
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Optional PostgreSQL adapter/test credentials; replace them outside an isolated workstation.
POSTGRES_DB=zeus
POSTGRES_USER=zeus
POSTGRES_PASSWORD=zeus_local_only
MINIO_ROOT_USER=zeus
MINIO_ROOT_PASSWORD=zeus_local_only_change_me
MINIO_BUCKET=zeus-artifacts

# Container-facing application configuration
ZEUS_LISTEN_ADDR=0.0.0.0:8081
ZEUS_DATABASE_PATH=/var/lib/zeus/zeus.db
# Safe default: production demo approvals are audited but no production
# executor is registered. Use an isolated database when switching profiles.
ZEUS_DEMO_PROFILE=production-guarded
ZEUS_LOCAL_MARKER_ROOT=/var/lib/zeus/local-markers
# Keep false for the checked-in HTTP-only local gateway. Set true only when
# the browser-facing Zeus origin is HTTPS.
ZEUS_COOKIE_SECURE=false
# Optional OpenAI-compatible Chat Completions provider. Leave all three empty
# for the explicit local non-model fallback; configure all three together.
ZEUS_LLM_ENDPOINT=
ZEUS_LLM_MODEL=
ZEUS_LLM_API_KEY=
# Logical SQLite admission defaults. Event slots and serialized UTF-8 payload
# bytes include the durable ledger plus outstanding finalization reservations.
# Payload bytes do not represent database-file, WAL, index, or free-disk usage.
ZEUS_MAX_SESSIONS_PER_SCOPE=1000
ZEUS_MAX_SESSIONS_GLOBAL=10000
ZEUS_MAX_OPEN_TURNS_PER_SCOPE=32
ZEUS_MAX_OPEN_TURNS_GLOBAL=64
ZEUS_MAX_ACTIVE_REPLY_JOBS_PER_SCOPE=32
ZEUS_MAX_ACTIVE_REPLY_JOBS_GLOBAL=64
ZEUS_MAX_ACTIVE_DISPATCH_JOBS_PER_SCOPE=16
ZEUS_MAX_ACTIVE_DISPATCH_JOBS_GLOBAL=32
ZEUS_MAX_AUTH_SESSIONS_PER_USER=32
ZEUS_MAX_AUTH_SESSIONS_GLOBAL=256
ZEUS_MAX_SESSION_EVENT_SLOTS_PER_SESSION=10000
ZEUS_MAX_RUN_EVENT_SLOTS_PER_RUN=50000
ZEUS_MAX_SESSION_EVENT_PAYLOAD_BYTES_PER_SESSION=67108864
ZEUS_MAX_RUN_EVENT_PAYLOAD_BYTES_PER_RUN=268435456
ZEUS_MAX_EVENT_PAYLOAD_BYTES_GLOBAL=1073741824
ZEUS_MAX_BOOTSTRAP_AUDIT_ROWS=1024
ZEUS_API_URL=http://zeus:8081
RESTATE_INGRESS_URL=http://restate:8080
RESTATE_ADMIN_URL=http://restate:9070
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=zeus
S3_SECRET_ACCESS_KEY=zeus_local_only_change_me
S3_FORCE_PATH_STYLE=true
RUST_LOG=zeus=debug,tower_http=info
RUST_BACKTRACE=1
