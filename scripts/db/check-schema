#!/usr/bin/env bash
set -euo pipefail

if [[ -z "${DATABASE_URL:-}" ]]; then
  echo "DATABASE_URL is required." >&2
  exit 1
fi

psql "${DATABASE_URL}" --no-psqlrc --set ON_ERROR_STOP=1 --tuples-only --command \
  "select uuid_extract_version(uuidv7()), count(*) from information_schema.tables where table_schema = 'public';"
