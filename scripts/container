#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd -- "${SCRIPT_DIR}/.." && pwd)"
ZEUS_STATE_DIR="${REPO_ROOT}/.zeus"
ZEUS_ENV_FILE="${ZEUS_STATE_DIR}/local.env"

ZEUS_PROFILE="local"
ZEUS_PUBLIC_HOST="127.0.0.1"
ZEUS_PUBLIC_PORT="3000"
ZEUS_POSTGRES_HOST_PORT="5432"

ZEUS_NETWORK="zeus-local"
ZEUS_POSTGRES_CONTAINER="zeus-postgres"
ZEUS_API_CONTAINER="zeus-api"
ZEUS_WEB_CONTAINER="zeus-web"
ZEUS_GATEWAY_CONTAINER="zeus-gateway"
ZEUS_MAILPIT_CONTAINER="zeus-mailpit"
ZEUS_E2E_OPENAI_CONTAINER="zeus-e2e-openai"
ZEUS_POSTGRES_VOLUME="zeus-postgres-data"
ZEUS_POSTGRES_IMAGE="docker.io/library/postgres:18.6"
ZEUS_API_IMAGE="zeus-api:0.1.0"
ZEUS_WEB_IMAGE="zeus-web:0.1.0"
ZEUS_GATEWAY_IMAGE="zeus-gateway:0.1.0"
ZEUS_MAILPIT_IMAGE="docker.io/axllent/mailpit:v1.30.0"
ZEUS_E2E_OPENAI_IMAGE="zeus-e2e-openai:0.1.0"

configure_e2e_profile() {
  ZEUS_PROFILE="e2e"
  ZEUS_STATE_DIR="${REPO_ROOT}/.zeus"
  ZEUS_ENV_FILE="${ZEUS_STATE_DIR}/e2e.env"
  ZEUS_PUBLIC_PORT="3100"
  ZEUS_POSTGRES_HOST_PORT="55432"
  ZEUS_NETWORK="zeus-e2e"
  ZEUS_POSTGRES_CONTAINER="zeus-e2e-postgres"
  ZEUS_API_CONTAINER="zeus-e2e-api"
  ZEUS_WEB_CONTAINER="zeus-e2e-web"
  ZEUS_GATEWAY_CONTAINER="zeus-e2e-gateway"
  ZEUS_MAILPIT_CONTAINER="zeus-e2e-mailpit"
  ZEUS_POSTGRES_VOLUME="zeus-e2e-postgres-data"
}

usage() {
  cat <<'EOF'
Usage: scripts/container <command> [target] [options]

Commands:
  init-env                         Create .zeus/local.env with mode 0600
  rotate-postgres-password        Rotate the local PostgreSQL password
  build [api|web|gateway|all]      Build local OCI images; default: all
  up [postgres|mailpit|api|web|gateway|all]
                                   Start a service and its dependencies; default: all
  down [postgres|mailpit|api|web|gateway|all]
                                   Stop services; default: all
  status [postgres|mailpit|api|web|gateway|all]
                                   Show safe container list fields; default: all
  logs <service> [flags]           Show logs; supports --follow, --boot, and -n
  reset-db --yes                   Remove the local database container and volume
  e2e <command>                    Use the isolated E2E stack on 127.0.0.1:3100
  help                             Show this help

E2E commands:
  e2e init-env                     Create .zeus/e2e.env with mode 0600
  e2e build [api|web|gateway|openai|all]
  e2e up [postgres|mailpit|openai|api|web|gateway|all]
  e2e down [postgres|mailpit|openai|api|web|gateway|all]
  e2e status [postgres|mailpit|openai|api|web|gateway|all]
  e2e logs <service> [flags]
  e2e seed                         Create the deterministic identity and workflow fixture
  e2e run                          Execute the API WorkItem approval flow
  e2e smoke                        Start, seed, and run the isolated stack
  e2e reset-db --yes               Remove only E2E containers and the E2E database volume

Examples:
  scripts/container up
  scripts/container build api
  scripts/container logs gateway -n 100
  scripts/container down all
  scripts/container e2e smoke
EOF
}

die() {
  echo "$*" >&2
  exit 1
}

require_no_extra_args() {
  if [[ "$#" -ne 0 ]]; then
    die "Unexpected argument: $1"
  fi
}

require_command() {
  local command_name="$1"
  if ! command -v "${command_name}" >/dev/null 2>&1; then
    die "${command_name} is required."
  fi
}

require_container_cli() {
  if ! command -v container >/dev/null 2>&1; then
    die "Apple container CLI is not installed."
  fi
}

require_openssl() {
  require_command openssl
}

create_build_context() {
  umask 077
  mkdir -p "${ZEUS_STATE_DIR}"
  mktemp -d "${ZEUS_STATE_DIR}/container-build.XXXXXX"
}

cleanup_build_context() {
  local build_context="$1"

  case "${build_context}" in
    "${ZEUS_STATE_DIR}"/container-build.*)
      local attempt
      for attempt in 1 2 3; do
        if /bin/rm -rf -- "${build_context}" && [[ ! -e "${build_context}" ]]; then
          return
        fi
        sleep 0.1
      done
      echo "Could not remove build context ${build_context}." >&2
      return 1
      ;;
    *)
      echo "Refused to remove unexpected build context ${build_context}." >&2
      ;;
  esac
}

init_env() {
  require_openssl

  umask 077
  mkdir -p "${ZEUS_STATE_DIR}"

  if [[ -f "${ZEUS_ENV_FILE}" ]]; then
    chmod 0600 "${ZEUS_ENV_FILE}"
    if ! grep -q '^ZEUS_BOOTSTRAP_TOKEN=' "${ZEUS_ENV_FILE}"; then
      local bootstrap_token
      bootstrap_token="$(openssl rand -hex 32)"
      printf '%s\n' "ZEUS_BOOTSTRAP_TOKEN=${bootstrap_token}" >> "${ZEUS_ENV_FILE}"
      unset bootstrap_token
    fi
    echo "Local environment already exists at ${ZEUS_ENV_FILE}; required identity settings are present."
    return
  fi

  local postgres_password master_key bootstrap_token
  postgres_password="$(openssl rand -hex 24)"
  master_key="$(openssl rand -hex 32)"
  bootstrap_token="$(openssl rand -hex 32)"

  printf '%s\n' \
    "POSTGRES_USER=zeus" \
    "POSTGRES_PASSWORD=${postgres_password}" \
    "POSTGRES_DB=zeus" \
    "DATABASE_URL=postgres://zeus:${postgres_password}@${ZEUS_PUBLIC_HOST}:${ZEUS_POSTGRES_HOST_PORT}/zeus" \
    "RUNTIME_DATABASE_URL=postgres://zeus:${postgres_password}@${ZEUS_PUBLIC_HOST}:${ZEUS_POSTGRES_HOST_PORT}/zeus" \
    "ZEUS_LOCAL_MASTER_KEY=${master_key}" \
    "ZEUS_BOOTSTRAP_TOKEN=${bootstrap_token}" \
    "ZEUS_ENVELOPE_KEY_ID=local-v1" \
    "ZEUS_BIND_ADDRESS=127.0.0.1:8080" \
    "ZEUS_PUBLIC_URL=http://${ZEUS_PUBLIC_HOST}:${ZEUS_PUBLIC_PORT}" \
    "ZEUS_API_URL=http://127.0.0.1:8080" \
    "ZEUS_COOKIE_SECURE=false" \
    "ZEUS_RUN_CONCURRENCY=4" \
    "ZEUS_SUPERVISOR_ENABLED=true" \
    "ZEUS_TRUST_PROXY_HEADERS=true" \
    "ZEUS_IDENTITY_MAINTENANCE_ENABLED=true" \
    > "${ZEUS_ENV_FILE}"

  if [[ "${ZEUS_PROFILE}" == "e2e" ]]; then
    local e2e_password e2e_model_key
    e2e_password="$(openssl rand -hex 16)"
    e2e_model_key="$(openssl rand -hex 24)"
    printf '%s\n' \
      "ZEUS_ALLOW_PRIVATE_MODEL_ENDPOINTS=true" \
      "ZEUS_E2E_PUBLIC_URL=http://${ZEUS_PUBLIC_HOST}:${ZEUS_PUBLIC_PORT}" \
      "ZEUS_E2E_EMAIL=e2e-admin@zeus.local" \
      "ZEUS_E2E_PASSWORD=${e2e_password}" \
      "ZEUS_E2E_MODEL_API_KEY=${e2e_model_key}" \
      >> "${ZEUS_ENV_FILE}"
    unset e2e_password e2e_model_key
  fi
  chmod 0600 "${ZEUS_ENV_FILE}"

  unset postgres_password master_key bootstrap_token
  echo "Created ${ZEUS_ENV_FILE} with mode 0600. Secret values were not printed."
}

load_local_env() {
  if [[ ! -f "${ZEUS_ENV_FILE}" ]]; then
    init_env
  fi

  chmod 0600 "${ZEUS_ENV_FILE}"
  set -a
  # shellcheck disable=SC1090
  source "${ZEUS_ENV_FILE}"
  set +a

  : "${POSTGRES_USER:?POSTGRES_USER is required in .zeus/local.env}"
  : "${POSTGRES_PASSWORD:?POSTGRES_PASSWORD is required in .zeus/local.env}"
  : "${POSTGRES_DB:?POSTGRES_DB is required in .zeus/local.env}"
  : "${ZEUS_LOCAL_MASTER_KEY:?ZEUS_LOCAL_MASTER_KEY is required in .zeus/local.env}"
}

set_env_value() {
  local key="$1"
  local value="$2"
  local temporary_env
  temporary_env="$(mktemp "${ZEUS_STATE_DIR}/${ZEUS_PROFILE}.env.update.XXXXXX")"
  chmod 0600 "${temporary_env}"

  if grep -q "^${key}=" "${ZEUS_ENV_FILE}"; then
    awk -v key="${key}" -v value="${value}" '
      index($0, key "=") == 1 { print key "=" value; next }
      { print }
    ' "${ZEUS_ENV_FILE}" > "${temporary_env}"
  else
    cp "${ZEUS_ENV_FILE}" "${temporary_env}"
    printf '%s=%s\n' "${key}" "${value}" >> "${temporary_env}"
  fi

  mv "${temporary_env}" "${ZEUS_ENV_FILE}"
  chmod 0600 "${ZEUS_ENV_FILE}"
}

container_exists() {
  container inspect "$1" >/dev/null 2>&1
}

container_is_running() {
  container list | awk -v container_name="$1" '
    NR > 1 && $1 == container_name { found = 1 }
    END { exit found ? 0 : 1 }
  '
}

image_exists() {
  container image inspect "$1" >/dev/null 2>&1
}

network_exists() {
  container network inspect "$1" >/dev/null 2>&1
}

volume_exists() {
  container volume inspect "$1" >/dev/null 2>&1
}

container_network() {
  container inspect "$1" \
    | /usr/bin/plutil -extract 0.configuration.networks.0.network raw -o - - 2>/dev/null
}

container_ipv4() {
  local cidr
  cidr="$(
    container inspect "$1" \
      | /usr/bin/plutil -extract 0.status.networks.0.ipv4Address raw -o - - 2>/dev/null
  )"
  if [[ -z "${cidr}" ]]; then
    die "Could not resolve the IPv4 address for $1."
  fi
  printf '%s\n' "${cidr%%/*}"
}

ensure_container_system() {
  container system start >/dev/null
}

ensure_network() {
  if ! network_exists "${ZEUS_NETWORK}"; then
    container network create \
      --label dev.zeus-harness.managed=true \
      --label dev.zeus-harness.project=zeus \
      "${ZEUS_NETWORK}" >/dev/null
    echo "Created Apple container network ${ZEUS_NETWORK}."
  fi
}

ensure_volume() {
  if ! volume_exists "${ZEUS_POSTGRES_VOLUME}"; then
    container volume create \
      --label dev.zeus-harness.managed=true \
      --label dev.zeus-harness.project=zeus \
      -s 20G \
      "${ZEUS_POSTGRES_VOLUME}" >/dev/null
    echo "Created PostgreSQL volume ${ZEUS_POSTGRES_VOLUME}."
  fi
}

stop_container() {
  local container_name="$1"
  local timeout_seconds="$2"

  if container_exists "${container_name}"; then
    container stop --time "${timeout_seconds}" "${container_name}" >/dev/null 2>&1 || true
  fi
}

delete_container() {
  local container_name="$1"
  if container_exists "${container_name}"; then
    container delete "${container_name}" >/dev/null
  fi
}

recreate_stateless_container() {
  local container_name="$1"
  local timeout_seconds="$2"
  stop_container "${container_name}" "${timeout_seconds}"
  delete_container "${container_name}"
}

prepare_postgres_container() {
  if ! container_exists "${ZEUS_POSTGRES_CONTAINER}"; then
    return
  fi

  local current_network
  current_network="$(container_network "${ZEUS_POSTGRES_CONTAINER}" || true)"
  if [[ "${current_network}" == "${ZEUS_NETWORK}" ]]; then
    return
  fi

  echo "Recreating ${ZEUS_POSTGRES_CONTAINER} on ${ZEUS_NETWORK}; the data volume is preserved."
  stop_container "${ZEUS_POSTGRES_CONTAINER}" 30
  delete_container "${ZEUS_POSTGRES_CONTAINER}"
}

sync_postgres_password() {
  export ZEUS_POSTGRES_PASSWORD_SYNC="${POSTGRES_PASSWORD}"
  printf '%s\n' \
    '\getenv zeus_password ZEUS_POSTGRES_PASSWORD_SYNC' \
    "ALTER ROLE zeus PASSWORD :'zeus_password';" \
    | container exec \
      --interactive \
      --env ZEUS_POSTGRES_PASSWORD_SYNC \
      "${ZEUS_POSTGRES_CONTAINER}" \
      psql \
      --username "${POSTGRES_USER}" \
      --dbname "${POSTGRES_DB}" \
      --no-psqlrc \
      --set ON_ERROR_STOP=1 >/dev/null
  unset ZEUS_POSTGRES_PASSWORD_SYNC
}

start_postgres() {
  require_container_cli
  load_local_env
  ensure_container_system
  ensure_network
  ensure_volume
  prepare_postgres_container

  if container_exists "${ZEUS_POSTGRES_CONTAINER}"; then
    container start "${ZEUS_POSTGRES_CONTAINER}" >/dev/null
  else
    container run \
      --name "${ZEUS_POSTGRES_CONTAINER}" \
      --detach \
      --network "${ZEUS_NETWORK}" \
      --cpus 2 \
      --memory 2G \
      --label dev.zeus-harness.managed=true \
      --label dev.zeus-harness.project=zeus \
      --env POSTGRES_USER \
      --env POSTGRES_PASSWORD \
      --env POSTGRES_DB \
      --publish "${ZEUS_PUBLIC_HOST}:${ZEUS_POSTGRES_HOST_PORT}:5432" \
      --volume "${ZEUS_POSTGRES_VOLUME}:/var/lib/postgresql" \
      "${ZEUS_POSTGRES_IMAGE}" >/dev/null
  fi

  local attempt
  for ((attempt = 1; attempt <= 60; attempt += 1)); do
    if container exec "${ZEUS_POSTGRES_CONTAINER}" \
      pg_isready -U "${POSTGRES_USER}" -d "${POSTGRES_DB}" >/dev/null 2>&1; then
      sync_postgres_password
      echo "PostgreSQL 18.6 is ready on ${ZEUS_PUBLIC_HOST}:${ZEUS_POSTGRES_HOST_PORT}."
      return
    fi
    sleep 1
  done

  echo "PostgreSQL did not become ready within 60 seconds." >&2
  container logs -n 100 "${ZEUS_POSTGRES_CONTAINER}" >&2 || true
  exit 1
}

bootstrap_database() {
  container exec \
    --interactive \
    "${ZEUS_POSTGRES_CONTAINER}" \
    psql \
    --username "${POSTGRES_USER}" \
    --dbname "${POSTGRES_DB}" \
    --no-psqlrc \
    --set ON_ERROR_STOP=1 \
    < "${REPO_ROOT}/scripts/db/bootstrap-roles.sql" >/dev/null
  echo "Database roles are ready."
}

container_database_url() {
  local postgres_ip="$1"
  printf 'postgres://%s:%s@%s:5432/%s\n' \
    "${POSTGRES_USER}" \
    "${POSTGRES_PASSWORD}" \
    "${postgres_ip}" \
    "${POSTGRES_DB}"
}

build_api_image() (
  require_command cargo
  local build_context
  build_context="$(create_build_context)"
  trap 'cleanup_build_context "${build_context}"' EXIT

  echo "Building ${ZEUS_API_IMAGE}."
  mkdir -p \
    "${build_context}/.cargo" \
    "${build_context}/apps" \
    "${build_context}/crates" \
    "${build_context}/db"

  if ! (
    cd "${build_context}"
    cargo vendor \
      --locked \
      --manifest-path "${REPO_ROOT}/Cargo.toml" \
      vendor \
      > .cargo/config.toml \
      2> cargo-vendor.log
  ); then
    echo "cargo vendor failed:" >&2
    tail -n 100 "${build_context}/cargo-vendor.log" >&2 || true
    exit 1
  fi
  /bin/rm -f "${build_context}/cargo-vendor.log"

  cp "${REPO_ROOT}/Cargo.toml" "${REPO_ROOT}/Cargo.lock" "${build_context}/"
  cp -R "${REPO_ROOT}/crates/zeus-core" "${build_context}/crates/zeus-core"
  cp -R "${REPO_ROOT}/crates/zeus-identity" "${build_context}/crates/zeus-identity"
  cp -R "${REPO_ROOT}/apps/zeus-api" "${build_context}/apps/zeus-api"
  cp -R "${REPO_ROOT}/db/migrations" "${build_context}/db/migrations"
  cp \
    "${REPO_ROOT}/deploy/container/zeus-api.local.Containerfile" \
    "${build_context}/Containerfile"

  (
    cd "${build_context}"
    container build \
      --tag "${ZEUS_API_IMAGE}" \
      --label dev.zeus-harness.project=zeus \
      --file Containerfile \
      .
  )
)

build_web_image() (
  require_command pnpm
  local build_context
  build_context="$(create_build_context)"
  trap 'cleanup_build_context "${build_context}"' EXIT

  echo "Building ${ZEUS_WEB_IMAGE}."
  (
    cd "${REPO_ROOT}"
    unset CI
    pnpm install --frozen-lockfile --config.confirmModulesPurge=false
    pnpm --filter @zeus/ui build
    pnpm --filter @zeus/web build
  )

  cp -R "${REPO_ROOT}/apps/web/build" "${build_context}/build"
  cp \
    "${REPO_ROOT}/deploy/container/web.local.Containerfile" \
    "${build_context}/Containerfile"

  (
    cd "${build_context}"
    container build \
      --tag "${ZEUS_WEB_IMAGE}" \
      --label dev.zeus-harness.project=zeus \
      --file Containerfile \
      .
  )
)

build_gateway_image() (
  local build_context
  build_context="$(create_build_context)"
  trap 'cleanup_build_context "${build_context}"' EXIT

  echo "Building ${ZEUS_GATEWAY_IMAGE}."
  cp "${REPO_ROOT}/deploy/container/Caddyfile.local" "${build_context}/Caddyfile"
  cp \
    "${REPO_ROOT}/deploy/container/gateway.local.Containerfile" \
    "${build_context}/Containerfile"

  (
    cd "${build_context}"
    container build \
      --tag "${ZEUS_GATEWAY_IMAGE}" \
      --label dev.zeus-harness.project=zeus \
      --file Containerfile \
      .
  )
)

build_e2e_openai_image() (
  if [[ "${ZEUS_PROFILE}" != "e2e" ]]; then
    die "The deterministic OpenAI-compatible image is only available in the E2E profile."
  fi
  local build_context
  build_context="$(create_build_context)"
  trap 'cleanup_build_context "${build_context}"' EXIT

  echo "Building ${ZEUS_E2E_OPENAI_IMAGE}."
  cp "${REPO_ROOT}/scripts/e2e/fake-openai.mjs" "${build_context}/fake-openai.mjs"
  cp \
    "${REPO_ROOT}/deploy/container/e2e-openai.Containerfile" \
    "${build_context}/Containerfile"

  (
    cd "${build_context}"
    container build \
      --tag "${ZEUS_E2E_OPENAI_IMAGE}" \
      --label dev.zeus-harness.project=zeus-e2e \
      --file Containerfile \
      .
  )
)

build_target() {
  local target="$1"
  require_container_cli
  ensure_container_system

  case "${target}" in
    api)
      build_api_image
      ;;
    web)
      build_web_image
      ;;
    gateway)
      build_gateway_image
      ;;
    openai)
      build_e2e_openai_image
      ;;
    all)
      build_api_image
      build_web_image
      build_gateway_image
      if [[ "${ZEUS_PROFILE}" == "e2e" ]]; then
        build_e2e_openai_image
      fi
      ;;
    *)
      die "Build target must be api, web, gateway, openai, or all."
      ;;
  esac
}

ensure_api_image() {
  if ! image_exists "${ZEUS_API_IMAGE}"; then
    build_api_image
  fi
}

ensure_web_image() {
  if ! image_exists "${ZEUS_WEB_IMAGE}"; then
    build_web_image
  fi
}

ensure_gateway_image() {
  if ! image_exists "${ZEUS_GATEWAY_IMAGE}"; then
    build_gateway_image
  fi
}

ensure_e2e_openai_image() {
  if ! image_exists "${ZEUS_E2E_OPENAI_IMAGE}"; then
    build_e2e_openai_image
  fi
}

migrate_database() {
  local postgres_ip database_url
  postgres_ip="$(container_ipv4 "${ZEUS_POSTGRES_CONTAINER}")"
  database_url="$(container_database_url "${postgres_ip}")"

  export DATABASE_URL="${database_url}"
  export RUNTIME_DATABASE_URL="${database_url}"
  if ! container run \
    --remove \
    --network "${ZEUS_NETWORK}" \
    --env DATABASE_URL \
    --env RUNTIME_DATABASE_URL \
    "${ZEUS_API_IMAGE}" db migrate; then
    echo "Database migration failed. Existing data was preserved." >&2
    echo "Inspect the migration error before using scripts/container reset-db --yes." >&2
    return 1
  fi
  unset database_url
  echo "Database migrations are ready."
}

wait_for_http() {
  local service_name="$1"
  local url="$2"
  local timeout_seconds="$3"
  local attempt

  for ((attempt = 1; attempt <= timeout_seconds; attempt += 1)); do
    if /usr/bin/curl --silent --show-error --fail "${url}" >/dev/null 2>&1; then
      return
    fi
    sleep 1
  done

  echo "${service_name} did not become ready within ${timeout_seconds} seconds." >&2
  container logs -n 100 "${service_name}" >&2 || true
  exit 1
}

start_e2e_openai() {
  if [[ "${ZEUS_PROFILE}" != "e2e" ]]; then
    die "The deterministic OpenAI-compatible service is only available in the E2E profile."
  fi
  require_container_cli
  ensure_container_system
  ensure_network
  ensure_e2e_openai_image
  export PORT="4010"

  recreate_stateless_container "${ZEUS_E2E_OPENAI_CONTAINER}" 10
  container run \
    --name "${ZEUS_E2E_OPENAI_CONTAINER}" \
    --detach \
    --init \
    --network "${ZEUS_NETWORK}" \
    --cpus 1 \
    --memory 256M \
    --label dev.zeus-harness.managed=true \
    --label dev.zeus-harness.project=zeus-e2e \
    --env PORT \
    "${ZEUS_E2E_OPENAI_IMAGE}" >/dev/null

  local attempt
  for ((attempt = 1; attempt <= 30; attempt += 1)); do
    if container exec "${ZEUS_E2E_OPENAI_CONTAINER}" \
      node -e 'fetch("http://127.0.0.1:4010/health").then((response) => process.exit(response.ok ? 0 : 1)).catch(() => process.exit(1))' \
      >/dev/null 2>&1; then
      local openai_ip
      openai_ip="$(container_ipv4 "${ZEUS_E2E_OPENAI_CONTAINER}")"
      set_env_value "ZEUS_E2E_MODEL_BASE_URL" "http://${openai_ip}:4010/v1"
      echo "Deterministic OpenAI-compatible E2E service is ready."
      return
    fi
    sleep 1
  done

  echo "Deterministic OpenAI-compatible E2E service did not become ready." >&2
  container logs -n 100 "${ZEUS_E2E_OPENAI_CONTAINER}" >&2 || true
  exit 1
}

start_api() {
  ensure_api_image
  bootstrap_database
  migrate_database

  local postgres_ip mailpit_ip database_url
  postgres_ip="$(container_ipv4 "${ZEUS_POSTGRES_CONTAINER}")"
  mailpit_ip="$(container_ipv4 "${ZEUS_MAILPIT_CONTAINER}")"
  database_url="$(container_database_url "${postgres_ip}")"

  export DATABASE_URL="${database_url}"
  export RUNTIME_DATABASE_URL="${database_url}"
  export ZEUS_BIND_ADDRESS="0.0.0.0:8080"
  export ZEUS_PUBLIC_URL="http://${ZEUS_PUBLIC_HOST}:${ZEUS_PUBLIC_PORT}"
  export ZEUS_COOKIE_SECURE="false"
  export ZEUS_RUN_CONCURRENCY="${ZEUS_RUN_CONCURRENCY:-4}"
  export ZEUS_SUPERVISOR_ENABLED="true"
  export ZEUS_ENVELOPE_KEY_ID="${ZEUS_ENVELOPE_KEY_ID:-local-v1}"
  export ZEUS_SMTP_URL="smtp://${mailpit_ip}:1025"
  export ZEUS_MAIL_FROM="noreply@zeus.local"
  export ZEUS_TRUST_PROXY_HEADERS="true"
  export ZEUS_IDENTITY_MAINTENANCE_ENABLED="true"
  export ZEUS_ALLOW_PRIVATE_MODEL_ENDPOINTS="${ZEUS_ALLOW_PRIVATE_MODEL_ENDPOINTS:-false}"

  recreate_stateless_container "${ZEUS_API_CONTAINER}" 60
  container run \
    --name "${ZEUS_API_CONTAINER}" \
    --detach \
    --init \
    --network "${ZEUS_NETWORK}" \
    --cpus 4 \
    --memory 2G \
    --label dev.zeus-harness.managed=true \
    --label dev.zeus-harness.project=zeus \
    --env DATABASE_URL \
    --env RUNTIME_DATABASE_URL \
    --env ZEUS_BIND_ADDRESS \
    --env ZEUS_PUBLIC_URL \
    --env ZEUS_COOKIE_SECURE \
    --env ZEUS_RUN_CONCURRENCY \
    --env ZEUS_SUPERVISOR_ENABLED \
    --env ZEUS_LOCAL_MASTER_KEY \
    --env ZEUS_ENVELOPE_KEY_ID \
    --env ZEUS_BOOTSTRAP_TOKEN \
    --env ZEUS_SMTP_URL \
    --env ZEUS_MAIL_FROM \
    --env ZEUS_TRUST_PROXY_HEADERS \
    --env ZEUS_IDENTITY_MAINTENANCE_ENABLED \
    --env ZEUS_ALLOW_PRIVATE_MODEL_ENDPOINTS \
    "${ZEUS_API_IMAGE}" >/dev/null

  unset database_url
  echo "zeus-api started on the private ${ZEUS_NETWORK} network."
}

start_web() {
  ensure_web_image

  local api_ip
  api_ip="$(container_ipv4 "${ZEUS_API_CONTAINER}")"
  export ZEUS_API_URL="http://${api_ip}:8080"
  export HOST="0.0.0.0"
  export PORT="3000"
  export ORIGIN="http://${ZEUS_PUBLIC_HOST}:${ZEUS_PUBLIC_PORT}"

  recreate_stateless_container "${ZEUS_WEB_CONTAINER}" 10
  container run \
    --name "${ZEUS_WEB_CONTAINER}" \
    --detach \
    --init \
    --network "${ZEUS_NETWORK}" \
    --cpus 2 \
    --memory 1G \
    --label dev.zeus-harness.managed=true \
    --label dev.zeus-harness.project=zeus \
    --env ZEUS_API_URL \
    --env HOST \
    --env PORT \
    --env ORIGIN \
    "${ZEUS_WEB_IMAGE}" >/dev/null

  echo "Zeus Web started on the private ${ZEUS_NETWORK} network."
}

start_mailpit() {
  require_container_cli
  ensure_container_system
  ensure_network
  export MP_WEBROOT="/mailpit/"

  recreate_stateless_container "${ZEUS_MAILPIT_CONTAINER}" 10
  container run \
    --name "${ZEUS_MAILPIT_CONTAINER}" \
    --detach \
    --init \
    --network "${ZEUS_NETWORK}" \
    --cpus 1 \
    --memory 512M \
    --label dev.zeus-harness.managed=true \
    --label dev.zeus-harness.project=zeus \
    --env MP_WEBROOT \
    "${ZEUS_MAILPIT_IMAGE}" >/dev/null
  echo "Mailpit started on the private ${ZEUS_NETWORK} network."
}

start_gateway() {
  ensure_gateway_image

  local api_ip web_ip mailpit_ip
  api_ip="$(container_ipv4 "${ZEUS_API_CONTAINER}")"
  web_ip="$(container_ipv4 "${ZEUS_WEB_CONTAINER}")"
  mailpit_ip="$(container_ipv4 "${ZEUS_MAILPIT_CONTAINER}")"
  export ZEUS_API_UPSTREAM="${api_ip}:8080"
  export ZEUS_WEB_UPSTREAM="${web_ip}:3000"
  export ZEUS_MAILPIT_UPSTREAM="${mailpit_ip}:8025"

  recreate_stateless_container "${ZEUS_GATEWAY_CONTAINER}" 10
  container run \
    --name "${ZEUS_GATEWAY_CONTAINER}" \
    --detach \
    --init \
    --network "${ZEUS_NETWORK}" \
    --cpus 1 \
    --memory 512M \
    --label dev.zeus-harness.managed=true \
    --label dev.zeus-harness.project=zeus \
    --env ZEUS_API_UPSTREAM \
    --env ZEUS_WEB_UPSTREAM \
    --env ZEUS_MAILPIT_UPSTREAM \
    --publish "${ZEUS_PUBLIC_HOST}:${ZEUS_PUBLIC_PORT}:3000" \
    "${ZEUS_GATEWAY_IMAGE}" >/dev/null

  wait_for_http "${ZEUS_GATEWAY_CONTAINER}" "http://${ZEUS_PUBLIC_HOST}:${ZEUS_PUBLIC_PORT}/health/ready" 90
  wait_for_http "${ZEUS_GATEWAY_CONTAINER}" "http://${ZEUS_PUBLIC_HOST}:${ZEUS_PUBLIC_PORT}/" 60
  echo "Zeus is ready on http://${ZEUS_PUBLIC_HOST}:${ZEUS_PUBLIC_PORT}. Mailpit is under /mailpit/."
}

up_target() {
  local target="$1"
  case "${target}" in
    postgres)
      start_postgres
      ;;
    mailpit)
      start_mailpit
      ;;
    openai)
      ensure_network
      start_e2e_openai
      ;;
    api)
      local web_was_running=false gateway_was_running=false
      start_postgres
      if container_is_running "${ZEUS_WEB_CONTAINER}"; then
        web_was_running=true
      fi
      if container_is_running "${ZEUS_GATEWAY_CONTAINER}"; then
        gateway_was_running=true
      fi
      start_mailpit
      if [[ "${ZEUS_PROFILE}" == "e2e" ]]; then
        start_e2e_openai
      fi
      start_api
      if [[ "${web_was_running}" == true || "${gateway_was_running}" == true ]]; then
        start_web
      fi
      if [[ "${gateway_was_running}" == true ]]; then
        start_gateway
      fi
      ;;
    web)
      local gateway_was_running=false
      start_postgres
      if container_is_running "${ZEUS_GATEWAY_CONTAINER}"; then
        gateway_was_running=true
      fi
      start_mailpit
      if [[ "${ZEUS_PROFILE}" == "e2e" ]]; then
        start_e2e_openai
      fi
      start_api
      start_web
      if [[ "${gateway_was_running}" == true ]]; then
        start_gateway
      fi
      ;;
    gateway | all)
      start_postgres
      start_mailpit
      if [[ "${ZEUS_PROFILE}" == "e2e" ]]; then
        start_e2e_openai
      fi
      start_api
      start_web
      start_gateway
      ;;
    *)
      die "Up target must be postgres, mailpit, openai, api, web, gateway, or all."
      ;;
  esac
}

down_target() {
  local target="$1"
  require_container_cli

  case "${target}" in
    postgres)
      stop_container "${ZEUS_POSTGRES_CONTAINER}" 30
      ;;
    mailpit)
      stop_container "${ZEUS_MAILPIT_CONTAINER}" 10
      ;;
    openai)
      stop_container "${ZEUS_E2E_OPENAI_CONTAINER}" 10
      ;;
    api)
      stop_container "${ZEUS_API_CONTAINER}" 60
      ;;
    web)
      stop_container "${ZEUS_WEB_CONTAINER}" 10
      ;;
    gateway)
      stop_container "${ZEUS_GATEWAY_CONTAINER}" 10
      ;;
    all)
      stop_container "${ZEUS_GATEWAY_CONTAINER}" 10
      stop_container "${ZEUS_WEB_CONTAINER}" 10
      stop_container "${ZEUS_API_CONTAINER}" 60
      if [[ "${ZEUS_PROFILE}" == "e2e" ]]; then
        stop_container "${ZEUS_E2E_OPENAI_CONTAINER}" 10
      fi
      stop_container "${ZEUS_MAILPIT_CONTAINER}" 10
      stop_container "${ZEUS_POSTGRES_CONTAINER}" 30
      ;;
    *)
      die "Down target must be postgres, mailpit, openai, api, web, gateway, or all."
      ;;
  esac
}

status_target() {
  local target="$1"
  local include_openai="false"
  require_container_cli

  if [[ "${ZEUS_PROFILE}" == "e2e" ]]; then
    include_openai="true"
  fi

  case "${target}" in
    postgres | mailpit | openai | api | web | gateway | all) ;;
    *) die "Status target must be postgres, mailpit, openai, api, web, gateway, or all." ;;
  esac

  container list --all | awk \
    -v target="${target}" \
    -v postgres="${ZEUS_POSTGRES_CONTAINER}" \
    -v mailpit="${ZEUS_MAILPIT_CONTAINER}" \
    -v api="${ZEUS_API_CONTAINER}" \
    -v web="${ZEUS_WEB_CONTAINER}" \
    -v gateway="${ZEUS_GATEWAY_CONTAINER}" \
    -v openai="${ZEUS_E2E_OPENAI_CONTAINER}" \
    -v include_openai="${include_openai}" '
      NR == 1 { print; next }
      target == "all" && ($1 == postgres || $1 == mailpit || (include_openai == "true" && $1 == openai) || $1 == api || $1 == web || $1 == gateway) { print; next }
      target == "postgres" && $1 == postgres { print; next }
      target == "mailpit" && $1 == mailpit { print; next }
      target == "openai" && $1 == openai { print; next }
      target == "api" && $1 == api { print; next }
      target == "web" && $1 == web { print; next }
      target == "gateway" && $1 == gateway { print }
    '
}

container_for_target() {
  case "$1" in
    postgres) printf '%s\n' "${ZEUS_POSTGRES_CONTAINER}" ;;
    mailpit) printf '%s\n' "${ZEUS_MAILPIT_CONTAINER}" ;;
    openai) printf '%s\n' "${ZEUS_E2E_OPENAI_CONTAINER}" ;;
    api) printf '%s\n' "${ZEUS_API_CONTAINER}" ;;
    web) printf '%s\n' "${ZEUS_WEB_CONTAINER}" ;;
    gateway) printf '%s\n' "${ZEUS_GATEWAY_CONTAINER}" ;;
    *) die "Log target must be postgres, mailpit, openai, api, web, or gateway." ;;
  esac
}

logs_target() {
  local target="$1"
  shift
  local container_name
  container_name="$(container_for_target "${target}")"

  require_container_cli
  if ! container_exists "${container_name}"; then
    die "${container_name} does not exist."
  fi
  container logs "$@" "${container_name}"
}

rotate_postgres_password() {
  require_container_cli
  require_openssl
  if [[ ! -f "${ZEUS_ENV_FILE}" ]]; then
    die "Local environment does not exist at ${ZEUS_ENV_FILE}."
  fi

  load_local_env
  if ! container_exists "${ZEUS_POSTGRES_CONTAINER}"; then
    die "${ZEUS_POSTGRES_CONTAINER} is not running. Start PostgreSQL before rotating its password."
  fi

  local rotated_password temporary_env
  rotated_password="$(openssl rand -hex 24)"
  temporary_env="$(mktemp "${ZEUS_STATE_DIR}/local.env.rotate.XXXXXX")"
  chmod 0600 "${temporary_env}"
  export ZEUS_ROTATED_PASSWORD="${rotated_password}"

  printf '%s\n' \
    '\getenv rotated_password ZEUS_ROTATED_PASSWORD' \
    "ALTER ROLE zeus PASSWORD :'rotated_password';" \
    | container exec \
      --interactive \
      --env ZEUS_ROTATED_PASSWORD \
      "${ZEUS_POSTGRES_CONTAINER}" \
      psql \
      --username "${POSTGRES_USER}" \
      --dbname "${POSTGRES_DB}" \
      --no-psqlrc \
      --set ON_ERROR_STOP=1 >/dev/null

  awk '
    /^POSTGRES_PASSWORD=/ {
      print "POSTGRES_PASSWORD=" ENVIRON["ZEUS_ROTATED_PASSWORD"]
      next
    }
    /^DATABASE_URL=/ {
      print "DATABASE_URL=postgres://zeus:" ENVIRON["ZEUS_ROTATED_PASSWORD"] "@127.0.0.1:5432/zeus"
      next
    }
    /^RUNTIME_DATABASE_URL=/ {
      print "RUNTIME_DATABASE_URL=postgres://zeus:" ENVIRON["ZEUS_ROTATED_PASSWORD"] "@127.0.0.1:5432/zeus"
      next
    }
    { print }
  ' "${ZEUS_ENV_FILE}" > "${temporary_env}"
  mv "${temporary_env}" "${ZEUS_ENV_FILE}"
  chmod 0600 "${ZEUS_ENV_FILE}"
  unset rotated_password ZEUS_ROTATED_PASSWORD

  echo "Rotated the local PostgreSQL password. Secret values were not printed."
  echo "Run scripts/container up all to refresh API and Web connections."
}

reset_database() {
  if [[ "${1:-}" != "--yes" || "$#" -ne 1 ]]; then
    echo "This removes the ${ZEUS_PROFILE} Zeus service containers and ${ZEUS_POSTGRES_VOLUME} volume." >&2
    if [[ "${ZEUS_PROFILE}" == "e2e" ]]; then
      echo "Run scripts/container e2e reset-db --yes to continue." >&2
    else
      echo "Run scripts/container reset-db --yes to continue." >&2
    fi
    exit 2
  fi

  require_container_cli
  stop_container "${ZEUS_GATEWAY_CONTAINER}" 10
  stop_container "${ZEUS_WEB_CONTAINER}" 10
  stop_container "${ZEUS_API_CONTAINER}" 60
  if [[ "${ZEUS_PROFILE}" == "e2e" ]]; then
    stop_container "${ZEUS_E2E_OPENAI_CONTAINER}" 10
  fi
  stop_container "${ZEUS_MAILPIT_CONTAINER}" 10
  stop_container "${ZEUS_POSTGRES_CONTAINER}" 30
  delete_container "${ZEUS_GATEWAY_CONTAINER}"
  delete_container "${ZEUS_WEB_CONTAINER}"
  delete_container "${ZEUS_API_CONTAINER}"
  if [[ "${ZEUS_PROFILE}" == "e2e" ]]; then
    delete_container "${ZEUS_E2E_OPENAI_CONTAINER}"
  fi
  delete_container "${ZEUS_MAILPIT_CONTAINER}"
  delete_container "${ZEUS_POSTGRES_CONTAINER}"

  if volume_exists "${ZEUS_POSTGRES_VOLUME}"; then
    container volume delete "${ZEUS_POSTGRES_VOLUME}" >/dev/null
  fi

  echo "Removed ${ZEUS_PROFILE} Zeus containers and PostgreSQL volume. Database contents are not recoverable without a backup."
  echo "Local environment, images, and network were preserved."
}

dispatch_command() {
  local command_name="$1"
  shift
  case "${command_name}" in
    init-env)
      require_no_extra_args "$@"
      init_env
      ;;
    rotate-postgres-password)
      require_no_extra_args "$@"
      rotate_postgres_password
      ;;
    build)
      local build_target_name="${1:-all}"
      if [[ "$#" -gt 0 ]]; then shift; fi
      require_no_extra_args "$@"
      build_target "${build_target_name}"
      ;;
    up)
      local up_target_name="${1:-all}"
      if [[ "$#" -gt 0 ]]; then shift; fi
      require_no_extra_args "$@"
      up_target "${up_target_name}"
      ;;
    down)
      local down_target_name="${1:-all}"
      if [[ "$#" -gt 0 ]]; then shift; fi
      require_no_extra_args "$@"
      down_target "${down_target_name}"
      ;;
    status)
      local status_target_name="${1:-all}"
      if [[ "$#" -gt 0 ]]; then shift; fi
      require_no_extra_args "$@"
      status_target "${status_target_name}"
      ;;
    logs)
      if [[ "$#" -eq 0 ]]; then
        die "Log target must be postgres, mailpit, openai, api, web, or gateway."
      fi
      local log_target_name="$1"
      shift
      logs_target "${log_target_name}" "$@"
      ;;
    reset-db)
      reset_database "$@"
      ;;
    help | --help | -h)
      require_no_extra_args "$@"
      usage
      ;;
    *)
      usage >&2
      die "Unknown command: ${command_name}"
      ;;
  esac
}

run_e2e_command() {
  local command_name="${1:-help}"
  if [[ "$#" -gt 0 ]]; then
    shift
  fi

  case "${command_name}" in
    seed | run)
      require_no_extra_args "$@"
      require_command node
      init_env
      node "${REPO_ROOT}/scripts/e2e/work-item.mjs" "${command_name}"
      ;;
    smoke)
      require_no_extra_args "$@"
      require_command node
      init_env
      up_target all
      node "${REPO_ROOT}/scripts/e2e/work-item.mjs" seed
      node "${REPO_ROOT}/scripts/e2e/work-item.mjs" run
      ;;
    *)
      dispatch_command "${command_name}" "$@"
      ;;
  esac
}

main() {
  local command_name="${1:-help}"
  if [[ "$#" -gt 0 ]]; then
    shift
  fi

  if [[ "${command_name}" == "e2e" ]]; then
    configure_e2e_profile
    run_e2e_command "$@"
  else
    dispatch_command "${command_name}" "$@"
  fi
}

main "$@"
