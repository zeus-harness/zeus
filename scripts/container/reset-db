#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=./common
source "${SCRIPT_DIR}/common"

if [[ "${1:-}" != "--yes" ]]; then
  echo "This removes the local zeus-postgres container and zeus-postgres-data volume." >&2
  echo "Run scripts/container/reset-db --yes to continue." >&2
  exit 2
fi

require_container_cli
if container inspect "${ZEUS_POSTGRES_CONTAINER}" >/dev/null 2>&1; then
  container stop "${ZEUS_POSTGRES_CONTAINER}" >/dev/null 2>&1 || true
  container delete "${ZEUS_POSTGRES_CONTAINER}"
fi
if container volume inspect "${ZEUS_POSTGRES_VOLUME}" >/dev/null 2>&1; then
  container volume delete "${ZEUS_POSTGRES_VOLUME}"
fi

echo "Removed local Zeus PostgreSQL container and volume. Local env was preserved."
