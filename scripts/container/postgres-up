#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=./common
source "${SCRIPT_DIR}/common"

require_container_cli
load_local_env
container system start >/dev/null

if container inspect "${ZEUS_POSTGRES_CONTAINER}" >/dev/null 2>&1; then
  container start "${ZEUS_POSTGRES_CONTAINER}" >/dev/null
else
  if ! container volume inspect "${ZEUS_POSTGRES_VOLUME}" >/dev/null 2>&1; then
    container volume create -s 20G "${ZEUS_POSTGRES_VOLUME}" >/dev/null
  fi

  container run \
    --name "${ZEUS_POSTGRES_CONTAINER}" \
    --detach \
    --cpus 2 \
    --memory 2G \
    --env POSTGRES_USER \
    --env POSTGRES_PASSWORD \
    --env POSTGRES_DB \
    --publish 127.0.0.1:5432:5432 \
    --volume "${ZEUS_POSTGRES_VOLUME}:/var/lib/postgresql" \
    docker.io/library/postgres:18.6 >/dev/null
fi

for _ in {1..60}; do
  if container exec "${ZEUS_POSTGRES_CONTAINER}" pg_isready -U "${POSTGRES_USER}" -d "${POSTGRES_DB}" >/dev/null 2>&1; then
    echo "PostgreSQL 18.6 is ready on 127.0.0.1:5432."
    exit 0
  fi
  sleep 1
done

echo "PostgreSQL did not become ready within 60 seconds." >&2
container logs "${ZEUS_POSTGRES_CONTAINER}" >&2 || true
exit 1
